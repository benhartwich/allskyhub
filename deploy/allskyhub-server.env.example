# /etc/allskyhub-server/allskyhub-server.env (root:allskyhub-server, 0640)
ALLSKYHUB_SERVER_DATABASE_URL=postgresql://allskyhub_server:CHANGE_ME@127.0.0.1:5432/allskyhub
ALLSKYHUB_SERVER_BASE_URL=https://allskyhub.org
ALLSKYHUB_SERVER_DATA_DIR=/var/lib/allskyhub-server
ALLSKYHUB_SERVER_TRUST_PROXY_HEADERS=true
ALLSKYHUB_SERVER_SESSION_COOKIE_SECURE=true
ALLSKYHUB_SERVER_LOG_FORMAT=json
# E-mail (roadmap #15), off while ALLSKYHUB_SERVER_SMTP_HOST is empty:
# ALLSKYHUB_SERVER_SMTP_HOST=postkasten.cloud
# ALLSKYHUB_SERVER_SMTP_PORT=587
# ALLSKYHUB_SERVER_SMTP_USER=noreply@allskyhub.org
# ALLSKYHUB_SERVER_SMTP_PASSWORD=...
# Values with spaces in double quotes (the file is read by systemd and by `. file`):
# ALLSKYHUB_SERVER_MAIL_FROM="allskyhub <noreply@allskyhub.org>"
# Admin page /admin (docs/betrieb.md), comma-separated:
# ALLSKYHUB_SERVER_ADMIN_EMAILS=mail@example.org
# Plus via Paddle Billing (roadmap N7), off until all five are set. Paddle dashboard:
# Developer tools > Authentication (API key with transaction, subscription and customer
# portal permissions; client-side token), Notifications (webhook to
# https://allskyhub.org/paddle/webhook, subscription.* events; its secret), Catalog
# (product Plus with a monthly and a yearly price, no trial: the hub gives the trial month).
# Checkout settings: default payment link https://allskyhub.org/plus/checkout
# ALLSKYHUB_SERVER_PADDLE_ENV=sandbox
# ALLSKYHUB_SERVER_PADDLE_API_KEY=pdl_sdbx_apikey_...
# ALLSKYHUB_SERVER_PADDLE_CLIENT_TOKEN=test_...
# ALLSKYHUB_SERVER_PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# ALLSKYHUB_SERVER_PADDLE_PRICE_MONTH=pri_...
# ALLSKYHUB_SERVER_PADDLE_PRICE_YEAR=pri_...
