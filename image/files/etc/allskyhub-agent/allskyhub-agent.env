# Options of the camera agent (allskyhub-agent.service). Hub URL, location, time zone and
# camera come from setup and live in /var/lib/allskyhub-agent/settings.json.
ALLSKYHUB_AGENT_ARGS="--asi-sdk /usr/local/lib/libASICamera2.so run --data /var/lib/allskyhub-agent/data --network nmcli --http 0.0.0.0:8080 --setup-file /var/lib/allskyhub-agent/setup.json"
