# /etc/allskyhub-server/allskyhub-server.env (root:allskyhub-server, 0640)
ALLSKYHUB_SERVER_DATABASE_URL=postgresql://allskyhub_server:CHANGE_ME@127.0.0.1:5432/allskyhub
ALLSKYHUB_SERVER_BASE_URL=https://allskyhub.org
ALLSKYHUB_SERVER_DATA_DIR=/var/lib/allskyhub-server
ALLSKYHUB_SERVER_TRUST_PROXY_HEADERS=true
ALLSKYHUB_SERVER_SESSION_COOKIE_SECURE=true
ALLSKYHUB_SERVER_ALLOW_SIGNUP=false
ALLSKYHUB_SERVER_LOG_FORMAT=json
