[Unit]
Description=allskyhub camera agent
After=network.target NetworkManager.service allskyhub-firstboot.service allskyhub-setupfile.service
Wants=NetworkManager.service

[Service]
User=allskyhub
Group=allskyhub
EnvironmentFile=/etc/allskyhub-agent/allskyhub-agent.env
ExecStart=/opt/allskyhub-agent/current/.venv/bin/allskyhub-agent $ALLSKYHUB_AGENT_ARGS
Restart=always
RestartSec=5
# SPEC §8.1: the agent pings while frames keep coming; a hung capture is restarted.
WatchdogSec=5min
NotifyAccess=main
StateDirectory=allskyhub-agent
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Cameras: ZWO over USB (udev rule makes it 0666), Raspberry Pi cameras through /dev/video*,
# /dev/media* and /dev/dma_heap (group video); weather sensor and heater through /dev/i2c-1
# and /dev/gpiochip* (groups i2c and gpio, SPEC §7.11).
SupplementaryGroups=video i2c gpio
DevicePolicy=auto

[Install]
WantedBy=multi-user.target
